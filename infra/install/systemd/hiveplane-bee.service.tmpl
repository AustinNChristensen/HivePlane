[Unit]
Description=HivePlane Bee daemon
Documentation=https://github.com/AustinNChristensen/HivePlane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__INSTALL_DIR__
Environment="PATH=__PATH__"
Environment="HIVEPLANE_CONFIG_DIR=__CONFIG_DIR__"
ExecStart=__PNPM_BIN__ --silent --filter @hiveplane/daemon start
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
